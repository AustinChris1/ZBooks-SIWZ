# ─── Required ────────────────────────────────────────────────────────

# Turso libSQL. Free tier at https://turso.tech (~60 seconds, no card).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

NEXTAUTH_URL=http://localhost:3000
SIWZ_DOMAIN=localhost:3000
SIWZ_NETWORK=mainnet
NEXT_PUBLIC_SIWZ_NETWORK=mainnet

# ─── Sign-in ─────────────────────────────────────────────────────────

# Demo mode: stub the block explorer so sign-in works without spending ZEC.
# Set to 0 with a real SIWZ_SERVICE_ADDRESS below to wire it to mainnet.
SIWZ_DEMO=1

# Transparent address you control. Users send ZEC here to authenticate.
# Generate: node scripts/gen-service-address.mjs
# WARNING: never use an address whose private key is public.
SIWZ_SERVICE_ADDRESS=

# ─── Optional ────────────────────────────────────────────────────────

# BLOCKCHAIR_API_KEY=

# Off-hours ledger sync. Point an external scheduler (cron-job.org etc)
# at /api/cron/sync-keys with header "Authorization: Bearer <token>".
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET=

# Shielded (zs.../u1...) service address. Requires a Zcash daemon with the
# IVK; public explorers can't decrypt memos. Pick ONE transport:
# ZCASH_RPC_URL=http://127.0.0.1:8232
# ZCASH_RPC_USER=
# ZCASH_RPC_PASS=
# ZCASH_CLI_PATH=/usr/local/bin/zcash-cli

# Discord webhook for approval notifications.
# DISCORD_WEBHOOK_URL=
